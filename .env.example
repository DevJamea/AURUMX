# ============================================================
# AurumX configuration — see docs/IMPLEMENTATION_PLAN.md
# SAFETY: a fresh install is READ-ONLY.  TRADING_ENABLED=false
# and DRY_RUN=true mean the system only observes and logs.
# ============================================================

APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
# LOG_FILE=logs/aurumx.log
DATA_DIR=data
DATABASE_URL=sqlite:///data/aurumx.db

# ---- Trading safety (do not enable casually) ----------------
TRADING_ENABLED=false
DRY_RUN=true
# Real-money execution is refused unless this EXACT phrase is set:
# REAL_TRADING_CONFIRMED=I ACCEPT REAL TRADING RISK

# ---- Market data --------------------------------------------
# AUTO = discover the broker's gold symbol automatically
SYMBOL=AUTO
TIMEFRAMES=M15,H1,H4
CANDLE_COUNT=400
MAX_TICK_AGE_SECONDS=60
CANDLE_FRESHNESS_MULTIPLIER=3.0
# Empty = broker-aware dynamic spread limit (enforced by the risk gate, Phase 4)
MAX_SPREAD_POINTS=

# ---- Risk (enforced by the hard risk gate, Phase 4) ---------
RISK_PER_TRADE=0.5
MAX_OPEN_POSITIONS=1
MAX_PENDING_ORDERS=2
MAX_DAILY_LOSS_PCT=2.0
MAX_TOTAL_RISK_PCT=2.0
MAX_DRAWDOWN_PCT=20.0
MIN_REWARD_RISK=1.5

# ---- Trade management feature flags -------------------------
ENABLE_BREAK_EVEN=true
ENABLE_TRAILING=false
ENABLE_PARTIAL_CLOSE=true

# ---- MetaTrader 5 connection --------------------------------
# Leave MT5_LOGIN empty to attach to the terminal that is already
# running / configured on this machine.  NEVER commit credentials.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=60000
